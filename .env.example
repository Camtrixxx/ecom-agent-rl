# 复制为 .env 后填。`.env` 已在 .gitignore 里，不会被提交。
#
# 为什么用环境变量而不是命令行参数：这是共用机器，命令行在 `ps` 里对所有用户
# 可见，也会留在 shell history 里。scripts/run_rollout.py 的 --base-url /
# --model / --api-key 默认读下面这三个变量。

# --- 被测模型（本地 vLLM，baseline 与 GRPO 采样） ---------------------------
# 端口与 scripts/serve_model.sh 的 LLM_PORT 一致；8000 在本机已被占用。
# 本地服务不校验 key，留空即可（留空时不会发 Authorization 头）。
LLM_BASE_URL=http://127.0.0.1:8180/v1
LLM_MODEL=ecom-agent
LLM_API_KEY=

# --- 教师模型（阶段 B 轨迹采集） --------------------------------------------
# 跑教师采集时改用这一组，例如：
#   set -a && . ./.env && set +a
#   LLM_BASE_URL="$TEACHER_BASE_URL" LLM_MODEL="$TEACHER_MODEL" \
#   LLM_API_KEY="$TEACHER_API_KEY" \
#   python scripts/run_rollout.py --pool data/task_pools/sft_train.jsonl ...
#
# deepseek-v4-flash 是参考实现用的那一档，教师侧口径与它对齐。
# 官方 OpenAI 兼容端点是 https://api.deepseek.com，路径 /chat/completions；
# 我们的客户端会自己拼 /chat/completions，所以这里给到 /v1 为止。
# 实测本机直连 api.deepseek.com 可达，不需要代理（客户端也已 trust_env=False）。
TEACHER_BASE_URL=https://api.deepseek.com/v1
TEACHER_MODEL=deepseek-v4-flash
TEACHER_API_KEY=

# 教师采集并发。环境侧不是瓶颈（8 worker ≈ 34 ep/s），受限的是 API 配额，
# 按实际额度填；超了会撞 429，客户端会退避重试但吞吐会掉。
TEACHER_CONCURRENCY=8

# --- 环境池 -----------------------------------------------------------------
# 并行跑 ablation 时每个实验必须用独立端口段，否则互抢 slot。
SHOPSIM_BASE_PORT=5700
SHOPSIM_WORKERS=8
