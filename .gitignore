__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

.DS_Store
# 本机工具权限，因人而异
.claude/settings.local.json
.venv/
.venv-*/
venv/
*.egg-info/
build/
dist/
.env
*.log

# 第三方环境由 scripts/setup_environment.sh 拉取，不提交
/third_party/

# 生成物。锚定到仓库根，否则会连带忽略 src/ecom_agent_rl/data/ 这类源码目录。
/outputs/
/checkpoints/
/models/
/data/*
/swanlog/
/wandb/
/logs/

# 例外：环境内容锚。它整个存在的意义就是「记在我们自己的 git 里」——环境树本身被
# 上面的 /third_party/ 忽略掉了，锚不入库就没有任何东西证明代码没变过。
#
# 写成 /data/* 而不是 /data/ 是必需的：git 不会进入被忽略的**目录**，目录级忽略
# 之下的否定规则根本不生效。每一层都要显式放行再重新忽略其内容。
!/data/environment/
/data/environment/*
!/data/environment/manifest.json

# 例外：血缘记录（provenance）是 provenance，不是生成物。数据本身很大且可由脚本
# 重建，但「这批数据是什么、出自哪里、sha256 是多少」重建不出来——文档里到处引用
# 这些 metadata.json，而它们此前一个都不在 git 里，等于血缘随机器消失。
!/data/task_pools/
/data/task_pools/*
!/data/task_pools/metadata.json
!/data/sft/
/data/sft/*
!/data/sft/metadata.json
!/data/sft_val/
/data/sft_val/*
!/data/sft_val/metadata.json
